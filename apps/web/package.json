{
  "name": "@crm/web",
  "type": "module",
  "scripts": {
    "dev": "bun run seed && bun run dev:server",
    "dev:server": "bun --env-file=../../.env --bun vite --configLoader native --config vite.config.ts",
    "dev:preview-server": "bun --bun vite --configLoader native --config vite.config.ts",
    "build": "bun --env-file=../../.env.production --bun vite build --configLoader native --config vite.config.ts",
    "build:container": "bun --bun vite build --configLoader native --config vite.config.ts",
    "build:workers": "BUILD_TARGET=workers bun --bun vite build --configLoader native --config vite.config.ts",
    "start": "bun run server.ts",
    "lint": "oxlint -c .oxlintrc.json --type-aware --tsconfig tsconfig.json --deny-warnings src tests",
    "typecheck": "tsc --noEmit",
    "test": "bun --bun --env-file=../../.env.test vitest run --project unit --project client --project contract --project integration --project journey",
    "test:unit": "bun --bun --env-file=../../.env.test vitest run --project unit",
    "test:client": "bun --bun --env-file=../../.env.test vitest run --project client",
    "test:contract": "bun --bun --env-file=../../.env.test vitest run --project contract",
    "test:integration": "bun --bun --env-file=../../.env.test vitest run --project integration",
    "test:journey": "bun --bun --env-file=../../.env.test vitest run --project journey",
    "test:e2e": "bun --bun --env-file=../../.env.test playwright test",
    "test:e2e:headed": "bun --bun --env-file=../../.env.test playwright test --headed",
    "test:e2e:ui": "bun --bun --env-file=../../.env.test playwright test --ui",
    "test:perf": "bun --env-file=../../.env.test vitest bench --run --config vitest.bench.config.ts",
    "db:reset": "shx rm -rf .local-storage/data && bun run seed",
    "seed": "bun --env-file=../../.env src/server/platform/database/seed.ts",
    "provision:prod": "bun src/server/platform/database/seed.ts",
    "stores:push": "bun src/server/platform/database/push-stores.ts",
    "cutover:safeapp": "bun --env-file=../../.env src/server/cutover/safeapp/cli.ts",
    "cutover:safeapp:prod": "bun src/server/cutover/safeapp/cli.ts"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@crm/email-composer": "workspace:*",
    "@crm/images": "workspace:*",
    "@crm/message-channels": "workspace:*",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/aleo": "^5.3.0",
    "@fontsource/host-grotesk": "^5.3.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@sentry/browser": "^11.10.0",
    "@sentry/bun": "^11.10.0",
    "@sentry/cloudflare": "^11.10.0",
    "@sentry/core": "^11.10.0",
    "@simplewebauthn/server": "^14.0.3",
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "^2.0.0-next.44",
    "@solidjs/web": "^2.0.0-rc.21",
    "@totallynotdavid/solid-motion": "0.1.2",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "eventsource-parser": "^4.1.3",
    "filesystem-routing": "^0.4.2",
    "kysely": "^0.29.8",
    "qrcode": "^1.5.4",
    "solid-js": "^2.0.0-rc.21",
    "three": "^0.187.0",
    "uuid": "^14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@codspeed/vitest-plugin": "^6.1.0",
    "@crm/tsconfig": "workspace:*",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.10.0",
    "@solidjs/vite-plugin": "^3.0.0-next.56",
    "@types/mdx": "^2.0.14",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.187.0",
    "eslint-plugin-solid": "^0.18.1",
    "happy-dom": "^21.0.4",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "rolldown": "^1.2.16",
    "rollup-plugin-visualizer": "^7.1.2",
    "seroval": "^1.7.7",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.165.0"
  }
}
